---
import LanguageSelector from "../components/LanguageSelector.svelte";
import ThemeToggle from "../components/ThemeToggle.svelte";
import { spring } from "motion";
import GithubIcon from "@lucide/svelte/icons/github";
---

<style define:vars={{ spring: spring(9, 0.2) }}>
  /* Header oculto inicialmente */
  header {
    opacity: 0;
    transform: translateY(-20px);
    animation: slideDown 0.8s var(--spring) forwards;
    animation-delay: 4s;
    will-change: transform, opacity;
  }

  @keyframes slideDown {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<header class="fixed w-[1100px] flex justify-between items-center py-12">
  <a href="#" class="text-4xl font-bold font-fig">Z</a>
  <div class="border size-12 rounded-2xl shadow-xs"></div>

  <div class="flex items-center">
    <LanguageSelector client:load />
    <ThemeToggle client:load />
  </div>

  <div class="absolute -right-8 top-[730px] rotate-270 font-vcr">// Zakiel ©</div>

  <div class="flex flex-col items-start gap-6 absolute top-[620px]">
    <div class="cursor-pointer relative right-0.5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="icon icon-tabler icons-tabler-filled icon-tabler-mail"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
