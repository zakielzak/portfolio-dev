---
interface Props {
  title: string;
  description: string;
  features: string[];
  techStack: string[];
  caseStudyHref: string;
  githubHref: string;
}

const { title, description, features, techStack, caseStudyHref, githubHref } =
  Astro.props;

import { Button } from "$lib/components/ui/button";
---

<div class="border h-[600px] p-6 flex flex-col">
  <span
    class="before:content-[''] before:rounded-[4px] before:inline-block before:size-4 dark:before:bg-white/80 before:bg-black before:mr-1 shrink-0 text-lg font-vcr"
  >
    //////////////// 01
  </span>
  <div class="flex h-full gap-8">
    <div class="flex flex-1 flex-col">
      <div>
        <span class="text-3xl font-bold">{title}</span>
        <p class="text-lg mt-2">{description}</p>
      </div>

      <div class="flex flex-col gap-3 mt-6 text-sm font-offbit">
        {features.map((feature) => <span>// {feature}</span>)}
      </div>

      <div class="flex items-center justify-between gap-4 mt-auto">
        <Button
          class="cursor-pointer clip rounded-none text-lg font-fig font-semibold bg-black dark:bg-white tracking-wide px-8 py-6 flex-1"
          href={caseStudyHref}
        >
          Case study

          <div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-right"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
                d="M13 6l6 6"></path></svg
            >
          </div>
        </Button>
        <Button
          variant="outline"
          class="cursor-pointer clip rounded-none text-lg font-fig font-semibold tracking-wide p-6 border-2 border-black dark:border-white dark:text-white flex-1"
          href={githubHref}
        >
          Github
          <div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="icon icon-tabler icons-tabler-filled icon-tabler-brand-github"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M5.315 2.1c.791 -.113 1.9 .145 3.333 .966l.272 .161l.16 .1l.397 -.083a13.3 13.3 0 0 1 4.59 -.08l.456 .08l.396 .083l.161 -.1c1.385 -.84 2.487 -1.17 3.322 -1.148l.164 .008l.147 .017l.076 .014l.05 .011l.144 .047a1 1 0 0 1 .53 .514a5.2 5.2 0 0 1 .397 2.91l-.047 .267l-.046 .196l.123 .163c.574 .795 .93 1.728 1.03 2.707l.023 .295l.007 .272c0 3.855 -1.659 5.883 -4.644 6.68l-.245 .061l-.132 .029l.014 .161l.008 .157l.004 .365l-.002 .213l-.003 3.834a1 1 0 0 1 -.883 .993l-.117 .007h-6a1 1 0 0 1 -.993 -.883l-.007 -.117v-.734c-1.818 .26 -3.03 -.424 -4.11 -1.878l-.535 -.766c-.28 -.396 -.455 -.579 -.589 -.644l-.048 -.019a1 1 0 0 1 .564 -1.918c.642 .188 1.074 .568 1.57 1.239l.538 .769c.76 1.079 1.36 1.459 2.609 1.191l.001 -.678l-.018 -.168a5.03 5.03 0 0 1 -.021 -.824l.017 -.185l.019 -.12l-.108 -.024c-2.976 -.71 -4.703 -2.573 -4.875 -6.139l-.01 -.31l-.004 -.292a5.6 5.6 0 0 1 .908 -3.051l.152 -.222l.122 -.163l-.045 -.196a5.2 5.2 0 0 1 .145 -2.642l.1 -.282l.106 -.253a1 1 0 0 1 .529 -.514l.144 -.047l.154 -.03z"
              ></path></svg
            >
          </div>
        </Button>
      </div>
    </div>
    <div class="flex-1/9 flex flex-col gap-6 ">
      <div class="border rounded-sm w-full h-full ">
        <!-- <div class="flex-1 border"></div>
        <div class="flex-1 border"></div> -->
      </div>
      <div class="flex items-center justify-end mt-auto gap-2 flex-wrap">
        {
          techStack.map((tech) => (
            <div class="cursor-pointer clip text-white font-semibold dark:bg-white bg-black p-2 text-xs dark:text-black flex items-center justify-between gap-1 ">
              <svg
                stroke="currentColor"
                fill="currentColor"
                stroke-width="0"
                role="img"
                viewBox="0 0 24 24"
                class="size-3 flex-shrink-0"
                aria-hidden="true"
                height="1em"
                width="1em"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.104.156.252.304.443.444s.423.276.696.41c.273.135.582.274.926.416.47.197.892.407 1.266.628.374.222.695.473.963.753.268.279.472.598.614.957.142.359.214.776.214 1.253 0 .657-.125 1.21-.373 1.656a3.033 3.033 0 0 1-1.012 1.085 4.38 4.38 0 0 1-1.487.596c-.566.12-1.163.18-1.79.18a9.916 9.916 0 0 1-1.84-.164 5.544 5.544 0 0 1-1.512-.493v-2.63a5.033 5.033 0 0 0 3.237 1.2c.333 0 .624-.03.872-.09.249-.06.456-.144.623-.25.166-.108.29-.234.373-.38a1.023 1.023 0 0 0-.074-1.089 2.12 2.12 0 0 0-.537-.5 5.597 5.597 0 0 0-.807-.444 27.72 27.72 0 0 0-1.007-.436c-.918-.383-1.602-.852-2.053-1.405-.45-.553-.676-1.222-.676-2.005 0-.614.123-1.141.369-1.582.246-.441.58-.804 1.004-1.089a4.494 4.494 0 0 1 1.47-.629 7.536 7.536 0 0 1 1.77-.201zm-15.113.188h9.563v2.166H9.506v9.646H6.789v-9.646H3.375z" />
              </svg>
              {tech}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

