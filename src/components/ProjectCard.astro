---
interface Props {
  title: string;
  description: string;
  features: string[];
  techStack: string[];
  caseStudyHref: string;
  githubHref: string;
}

const { title, description, features, techStack, caseStudyHref, githubHref } =
  Astro.props;

import { Button } from "$lib/components/ui/button";
---

<div class="w-ful flex gap-2">
  <div class="flex-1">
    <span>{title}</span>
    <p>{description}</p>
    <div class="flex flex-col gap-3 mt-6 text-sm font-offbit">
      {features.map((feature) => <span>// {feature}</span>)}
      <div class="flex mt-4 gap-4">
        <Button variant="link" class="cursor-pointer" href={caseStudyHref}>
          Case study
        </Button>
        <Button variant="outline" class="cursor-pointer" href={githubHref} >
            Github
        </Button>
      </div>
    </div>
  </div>
  <div class="flex-1 flex flex-col gap-4">
    <div class="border rounded-sm w-full h-[270px]"></div>
    <div class="flex gap-2">
      {
        techStack.map((tech) => (
          <Button variant="outline" class="cursor-pointer">
            {tech}
          </Button>
        ))
      }
    </div>
  </div>
</div>
