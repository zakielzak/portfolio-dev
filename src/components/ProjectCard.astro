---
import type { TechID } from "../const";
import { TECHS } from "../const";
import { m } from "../paraglide/messages";

interface Props {
  index: number;
  label: string;
  title: string;
  description: string;
  features: string[];
  techStack: TechID[];
  caseStudyHref: string;
  githubHref: string;
}

const {
  index = 1,
  label,
  title,
  description,
  features,
  techStack,
  caseStudyHref,
  githubHref,
} = Astro.props;

import { Button } from "$lib/components/ui/button";
---

<div
  class="h-[600px] z-30 bg-background border rounded-xs px-6 pb-6 pt-4 flex flex-col project-item"
>
  <div
    class="shrink-0 text-lg font-vcr flex gap-4 items-center justify-between uppercase"
  >
    <div class="flex gap-2 items-center">
      <div class="dark:bg-white/80 bg-black h-4 w-4 rounded"></div>
      <span>{`PROJECT_${String(index).padStart(2, "0")}`}</span>
    </div>

    //////////////////////// {label}
  </div>
  <div class="flex h-full gap-8">
    <div class="flex flex-1 flex-col">
      <div>
        <span class="text-3xl font-bold">{title}</span>
        <p class="text-lg mt-2">{description}</p>
      </div>

      <div
        class="flex flex-col gap-3 mt-6 text-sm tracking-wide font-medium font-offbit"
      >
        {features.map((f) => <span>// {f}</span>)}
      </div>

      <div class="flex items-center justify-between gap-4 mt-auto">
        <Button
          class="cursor-pointer clip rounded-none text-lg font-fig font-semibold bg-black dark:bg-white tracking-wide px-8 py-6 flex-1 transition duration-300 hover:scale-[1.09] active:scale-[0.98]"
          href={caseStudyHref}
        >
          <!--  Case study -->
          {m.case_study}
          <!-- <Icon name="arrow-right" /> -->

          <div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-right"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
                d="M13 6l6 6"></path></svg
            >
          </div>
        </Button>
        <a
          class="cursor-pointer rounded-none text-lg font-fig font-semibold tracking-wide dark:text-white clip-polygon-shape transition duration-300 hover:scale-[1.09] active:scale-[0.98] h-full border flex-1"
          href={githubHref}
        >
          <div
            class="clip-polygon-shape p-[1.5px] bg-black dark:bg-white rounded-none h-full"
          >
            <div
              class="clip-polygon-shape bg-white dark:bg-black text-black dark:text-white
                             items-center justify-center gap-2
                             flex text-lg font-semibold tracking-wide px-10 h-full has-[>svg]:px-3 whitespace-nowrap rounded-none outline-none"
            >
              Github
              <div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="icon icon-tabler icons-tabler-filled icon-tabler-brand-github"
                  ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                  ></path><path
                    d="M5.315 2.1c.791 -.113 1.9 .145 3.333 .966l.272 .161l.16 .1l.397 -.083a13.3 13.3 0 0 1 4.59 -.08l.456 .08l.396 .083l.161 -.1c1.385 -.84 2.487 -1.17 3.322 -1.148l.164 .008l.147 .017l.076 .014l.05 .011l.144 .047a1 1 0 0 1 .53 .514a5.2 5.2 0 0 1 .397 2.91l-.047 .267l-.046 .196l.123 .163c.574 .795 .93 1.728 1.03 2.707l.023 .295l.007 .272c0 3.855 -1.659 5.883 -4.644 6.68l-.245 .061l-.132 .029l.014 .161l.008 .157l.004 .365l-.002 .213l-.003 3.834a1 1 0 0 1 -.883 .993l-.117 .007h-6a1 1 0 0 1 -.993 -.883l-.007 -.117v-.734c-1.818 .26 -3.03 -.424 -4.11 -1.878l-.535 -.766c-.28 -.396 -.455 -.579 -.589 -.644l-.048 -.019a1 1 0 0 1 .564 -1.918c.642 .188 1.074 .568 1.57 1.239l.538 .769c.76 1.079 1.36 1.459 2.609 1.191l.001 -.678l-.018 -.168a5.03 5.03 0 0 1 -.021 -.824l.017 -.185l.019 -.12l-.108 -.024c-2.976 -.71 -4.703 -2.573 -4.875 -6.139l-.01 -.31l-.004 -.292a5.6 5.6 0 0 1 .908 -3.051l.152 -.222l.122 -.163l-.045 -.196a5.2 5.2 0 0 1 .145 -2.642l.1 -.282l.106 -.253a1 1 0 0 1 .529 -.514l.144 -.047l.154 -.03z"
                  ></path></svg
                >
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
    <div class="flex-1/9 flex flex-col gap-6">
      <div
        class="rounded-sm w-full h-full overflow-hidden flex flex-col justify-center gap-2"
      >
        <div class="rounded-sm border h-56">
          <img
            src={/* `/assets/projects/project_${index}.png` */ "https://cdn.prod.website-files.com/6752ffb0df2974a0b81c85e8/6752ffb0df2974a0b81c86ac_Container-p-1080.png"}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="rounded-sm border h-56">
          <img
            src={/* `/assets/projects/project_${index}.png` */ "https://cdn.prod.website-files.com/6752ffb0df2974a0b81c85e8/6752ffb0df2974a0b81c86ac_Container-p-1080.png"}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="flex items-center justify-end mt-auto gap-2 flex-wrap">
        {
          techStack.map((id) => {
            const tech = TECHS[id];
            return (
              <div class="clip rounded-xs text-white font-semibold dark:bg-white bg-black p-2 text-xs dark:text-black flex items-center justify-between gap-1 font-vcr">
                <span set:html={tech.svg} class="" />
                {tech.name}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
