---
export type Name = "arrow-right" | "github";

const map: Record<Name, string> = {
  "arrow-right":
    '<path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  github: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 5v-3.5a3.5 3.5 0 0 0-1-3c2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C4.4 1.6 3.3 1.9 3.3 1.9a4.2 4.2 0 0 0-.1 3.2 4.6 4.6 0 0 0-1.3 3.2c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2v3.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
};

const { name, class: cls = "w-6 h-6" } = Astro.props as { name: Name; class?: string };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  class:list={["inline", cls]}
  set:html={map[name]}
/>
