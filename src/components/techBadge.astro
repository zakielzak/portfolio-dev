---
import type { TechID } from "../const";
import { TECHS } from "../const";

export interface Props {
  techs: TechID[];
}

const { techs } = Astro.props;
---

{
  techs.map((id) => {
    const tech = TECHS[id];
    return (
      <div class="text-[11px] font-semibold font-fig border p-1.5 rounded-br-lg flex items-center justify-between gap-1">
        <span set:html={tech.svg} />
        {tech.name}
      </div>
    );
  })
}
