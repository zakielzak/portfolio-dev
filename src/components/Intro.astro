---
import { m } from "../paraglide/messages";
import { spring } from "motion";
---

<style
  define:vars={{
    mainTitle: spring(5, 0.4),
    introText: spring(6, 0.1),
  }}
>
  .main-title {
    opacity: 0;
    transform: translateY(20px);
    animation: slideInBounce 2s var(--mainTitle) forwards;
    animation-delay: 1s;
    will-change: transform, opacity;
  }

  .intro-text {
    opacity: 0;
    transform: translateY(30px);
    animation: slideInSmooth 1s var(--introText) forwards;
    animation-delay: 2.5s;
    will-change: transform, opacity;
  }

  @keyframes slideInBounce {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInSmooth {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<section
  class="flex flex-col justify-center h-[600px] relative"
  id="intro-section"
>
