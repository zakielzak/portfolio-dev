  <style
    define:vars={{
      mainTitle: spring(5, 0.4),
      introText: spring(6, 0.1),
      springFast: spring(9, 0.2),
      springDeliberate: spring(9, 0.05),
    }}
  >
    .main-title {
      opacity: 0;
      transform: translateY(20px);
      animation: slideInBounce 2s var(--mainTitle) forwards;
      animation-delay: 1s;
      will-change: transform, opacity;
    }

    /* Párrafo intro - oculto inicialmente */
    .intro-text {
      opacity: 0;
      transform: translateY(30px);
      animation: slideInSmooth 1s var(--introText) forwards;
      animation-delay: 2.5s;
      will-change: transform, opacity;
    }

    /* Título proyectos - oculto inicialmente */
    .projects-title {
      opacity: 1;
      /*  transform: translateY(30px);
      animation: slideInBounce 0.8s var(--springBounce) forwards;
      animation-delay: 3s; */
      will-change: transform, opacity;
    }

    /* Tarjetas de proyecto - ocultas inicialmente */
    .project-card {
      opacity: 1;
      /*   transform: translateY(30px);
      animation: slideInFast 0.6s var(--springFast) forwards; */
      will-change: transform, opacity;
    }
    .project-card:nth-child(1) {
      animation-delay: 4s;
    }
    .project-card:nth-child(2) {
      animation-delay: 4.4s;
    }
    .project-card:nth-child(3) {
      animation-delay: 4.8s;
    }

    /* Sección about - oculta inicialmente */
    .about-section {
      opacity: 1;
      /* transform: translateY(30px); */
      /*  animation: slideInDeliberate 1.5s var(--springDeliberate) forwards;
      animation-delay: 5.5s; */
      will-change: transform, opacity;
    }

    /* Keyframes */
    @keyframes slideInBounce {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInSmooth {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInFast {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInDeliberate {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
