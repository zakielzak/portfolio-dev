            </div> -->
            <div
              class="col-start-3 col-span-2 row-start-8 row-span-4 border px-4 py-3.5"
            >
            </div>
            <div
              class="col-start-3 col-span-1 row-start-12 row-span-3 border px-4 py-3.5"
            >
            </div>
            <div
              class="col-start-4 col-span-1 row-start-12 row-span-3 border px-4 py-3.5"
            >
            </div>

            <div
              class="col-span-2 col-start-3 row-start-6 row-span-2 border font-fig flex flex-col items-center justify-center relative group overflow-hidden transition-all hover:bg-black/80 dark:hover:bg-white/80"
            >
              <span
                class="text-2xl font-semibold transition-opacity duration-500 ease-in-out group-hover:opacity-0 group-hover:invisible"
                >"Make it exist first, then improve it."</span
              >

              <p
                class="text-xs font-medium flex px-4 items-center justify-center absolute inset-0 opacity-0 transition-all duration-500 ease-in-out group-hover:opacity-100 text-white dark:text-black"
              >
                I focus on starting with a simple but solid foundation, and then
                adding value by refining it with details that truly enhance it.
                This iterative process allows me to work efficiently and deliver
                high-quality results.
              </p>
            </div>
            <!-- <div
              class="col-span-2 col-start-3 row-start-12 row-span-3 border font-fig flex flex-col items-center justify-center relative"
            >
              Github History
            </div> -->
          </div>

          <!--  <div class="flex flex-col gap-3">
            <span class="font-semibold">{m.about_subtitle()}</span>
            <p>
              {m.about_p1()}
            </p>

            <p>
              {m.about_p2()}
            </p>

            <p>
