---
import Layout from "../layouts/Layout.astro";

import Intro from "../components/Intro.astro";
import ProjectCard from "src/components/ProjectCard.astro";
import Profile from "src/components/Profile.astro";

import type { TechID } from "../const";
import { m } from "../paraglide/messages";

// Importar el nuevo componente Svelte
import Sphere from "../components/Sphere.svelte";


const projects = [
  {
    label: "MUSIC_PLAYER_APP",
    title: m.project_music_title(),
    description: m.project_music_desc(),

    features: [
      m.project_music_f1(),
      m.project_music_f2(),
      m.project_music_f3(),
      m.project_music_f4(),
    ],
    techStack: [
      "TypeScript",
      "React",
      "Rust",
      "HTML",
      "TailwindCSS",
    ] as TechID[],
    caseStudyHref: "/projects/music-app",
    githubHref: "https://github.com/your-repo-music-app",
  },
  {
    label: "IMAGE_MANAGER_APP",
    title: m.project_image_title(),
    description: m.project_image_desc(),
    features: [
      m.project_image_f1(),
      m.project_image_f2(),
      m.project_image_f3(),
      m.project_image_f4(),
    ],
    techStack: ["TypeScript", "React", "Rust"] as TechID[],
    caseStudyHref: "/projects/image-manager",
    githubHref: "https://github.com/your-repo-image-manager",
  },
  {
    label: "PRODUCTIVITY_APP",
    title: m.project_productivity_title(),
    description: m.project_productivity_desc(),
    features: [
      m.project_productivity_f1(),
      m.project_productivity_f2(),
      m.project_productivity_f3(),
      m.project_productivity_f4(),
    ],
    techStack: ["TypeScript", "React", "Rust"] as TechID[],
    caseStudyHref: "/projects/productivity-app",
    githubHref: "https://github.com/your-repo-productivity-app",
  },
];
---



<Sphere client:load  media={{ mobile: 480, tablet: 992 }} />
<Layout title="Zakiel" lang={Astro.currentLocale || "en"}>
  <Intro />

  <section id="projects-section" class="mt-[80px] flex flex-col gap-24">
    {
      projects.map((p, i) => (
        <ProjectCard
          index={i + 1}
          label={p.label}
          title={p.title}
          description={p.description}
          features={p.features}
          techStack={p.techStack}
          caseStudyHref={p.caseStudyHref}
          githubHref={p.githubHref}
        />
      ))
    }
  </section>

  <Profile />

  <script>
    import { scroll, animate, inView } from "motion";

    const projects = document.querySelectorAll<HTMLElement>(".project-item");

    // 1. Selectores de las secciones a animar.
    // Asegúrate de que tus componentes Intro y Profile tengan estos ID/clases.
    const sectionSelectors = ["#intro-section", "#profile-section"];

    // 2. Opciones y Parámetros de la Animación
    const INITIAL_Y_OFFSET = 50; // Desplazamiento inicial (abajo)
    const DURATION = 0.8; // Duración de la animación en segundos
    const EASE = [0.17, 0.55, 0.55, 1]; // Curva de easing premium (easeInOutQuart)

    sectionSelectors.forEach((selector) => {
      const section = document.querySelector(selector);

      if (!section) {
        console.warn(`Sección no encontrada: ${selector}. Saltando animación.`);
        return;
      }

      // --- Configuración de Estado Inicial (Cero Duración) ---
      // Aplicamos el estado de 'origen' de la animación inmediatamente, sin transición.
      animate(section, { opacity: 0, y: INITIAL_Y_OFFSET }, { duration: 0 });

      // --- Detección y Disparo con inView ---
      inView(
        section,
        (element) => {
          // El callback se ejecuta cuando el elemento entra en la vista.

          // Animación de entrada: de (opacity: 0, y: 50) a (opacity: 1, y: 0)
          animate(
            element,
            { opacity: 1, transform: "translateY(0px)" },
            {
              duration: DURATION,
              easing: EASE,
            }
          );

          // LA CLAVE: No devolver nada; la animación se ejecuta solo una vez si inView está configurado correctamente.
        },
        {
          // Opciones del Intersection Observer interno:
          // Margen que dispara la animación antes de que la sección esté totalmente visible.
          // -15% significa que la intersección se considera cuando el elemento está a 15% del borde inferior.
          margin: "0px 0px -15% 0px",
          // amount: "some" (predeterminado) es suficiente para un efecto de aparición.
        }
      );
    });

    projects.forEach((project) => {
      const scrollOptions = {
        target: project,
        container: document.documentElement,
        // La animación se ejecuta entre el 80% (entra) y el 20% (sale) del viewport.
        offset: ["start 80%", "end 20%"] as const,
      };

      // Parámetros de la animación
      const MAX_SHRINK = 0.1; // Se encogerá un 10% (Scale irá de 1 a 0.9)
      const MAX_Y_OFFSET = 50; // Desplazamiento máximo en píxeles (50px)

      scroll((progress: number) => {
        const midPointProgress =
          progress < 0.5
            ? progress * 2 // 0.0 -> 1.0
            : (1 - progress) * 2; // 1.0 -> 0.0

        const scale = 1 - MAX_SHRINK + midPointProgress * MAX_SHRINK;

        const opacity = midPointProgress;

        const translateY = (1 - midPointProgress) * MAX_Y_OFFSET;

        animate(
          project,
          {
            opacity: opacity,
            transform: `translateY(${translateY}px) .scale(${scale})`,
          },
          { duration: 0 }
        );
      }, scrollOptions as any);
    });
  </script>
</Layout>
