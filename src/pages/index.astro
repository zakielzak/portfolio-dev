          class="flex items-center gap-2 text-white text-lg font-vcr relative"
        >
          <span class="absolute -left-10.5 text-sm font-vcr">Home</span>
          <div class="relative w-3 h-6">
            <div
              class="absolute top-0 left-0 w-1 h-1 border-t border-l border-white"
            >
            </div>
            <div
              class="absolute top-0 right-0 w-1 h-1 border-t border-r border-white"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 w-1 h-1 border-b border-l border-white"
            >
            </div>
            <div
              class="absolute bottom-0 right-0 w-1 h-1 border-b border-r border-white"
            >
            </div>
          </div>
        </a>

        <div class="flex flex-col gap-3 mt-4">
          <a
            href="#section1"
            class="w-3 h-3 bg-white/40 hover:bg-gray-400 transition-colors"></a>
          <a
            href="#section2"
            class="w-3 h-3 bg-white/40 hover:bg-gray-400 transition-colors"></a>
        </div>
      </nav>
    </header>
  </div>

