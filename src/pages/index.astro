            <span>Techstack</span>
            <p>
              {m.tech()}
            </p>
            <div class="flex gap-5 flex-wrap">
              {techStack.map((tech) => <div>{tech}</div>)}
            </div> -->
        </section>
      </div>
    </section>
  </div>
</Layout>
<script>
  import { scroll, animate } from "motion";

  const projects = document.querySelectorAll<HTMLElement>(".project-item");
  const projectContainer = document.getElementById("projects-content-wrapper");
  const projectTitle = document.getElementById("projects-title");

  if (projects.length === 0 || !projectContainer || !projectTitle) {
    console.warn(
      "No se encontraron todos los elementos necesarios para la animación de scroll."
    );
  }

  /**
   * 3. Configuración y Animación de Scroll
   * Se utiliza el patrón de 'scroll-linked animation' de Motion para enlazar
   * la opacidad y posición de cada proyecto al progreso del scroll.
   */
  projects.forEach((project, index) => {
    const scrollOptions = {
      target: project,
      container: document.documentElement,

      // El problema estaba aquí. Aunque es un string[], lo definimos.
      offset: ["start 80%", "end 20%"] as const, // Usamos 'as const' para tipificar como tupla estricta
    };

    // Usamos una aserción de tipo genérica al llamar a 'scroll()' para
    // que TypeScript use la inferencia del tipo de opciones que espera la función.
    // Esto es más simple y efectivo que importar tipos internos.

    // --- ANIMACIÓN DE OPACIDAD ---
    scroll((progress: number) => {
      const opacity = progress < 0.5 ? progress * 2 : (1 - progress) * 2;
      animate(project, { opacity: opacity }, { duration: 0 });
    }, scrollOptions as any); // <-- Aserción 'any' en la llamada para forzar compatibilidad

    // --- ANIMACIÓN DE TRANSFORMACIÓN ---
    scroll((progress: number) => {
      const translateY = (1 - progress) * 50;
      animate(
        project,
        { transform: `translateY(${translateY}px)` },
        { duration: 0 }
      );
    }, scrollOptions as any); // <-- Aserción 'any' en la llamada para forzar compatibilidad
  });

  // Ejecutar después de que el DOM esté listo
  import { textScramble } from "../lib/textScramble.ts";

  const greetingElement = document.getElementById("greeting-text");
  const introElement = document.getElementById("intro-text");

  if (introElement) {
    // Opcional: definir un conjunto de caracteres japoneses personalizado
    const japaneseChars =
      "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
    /* const japaneseChars =
        "アァカサタナハマヤ"; */

    textScramble(introElement, {
      duration: 1.2, // Una duración más larga para un efecto más dramático
      speed: 0.05,
      characterSet: japaneseChars,
      delay: 2.5,
    });
  }

  if (greetingElement) {
    // Opcional: definir un conjunto de caracteres japoneses personalizado
    const japaneseChars =
      "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
    /* const japaneseChars =
        "アァカサタナハマヤ"; */

    textScramble(greetingElement, {
      duration: 1.2, // Una duración más larga para un efecto más dramático
      speed: 0.05,
      characterSet: japaneseChars,
      delay: 1,
    });
  }
</script>
