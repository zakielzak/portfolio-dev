---
import Layout from "../layouts/Layout.astro";

import Intro from "../components/Intro.astro";
import ProjectCard from "src/components/ProjectCard.astro";
import Profile from "src/components/Profile.astro";

import type { TechID } from "../const";
import { m } from "../paraglide/messages";

const projects = [
  {
    label: "MUSIC_PLAYER_APP",
    title: m.project_music_title(),
    description: m.project_music_desc(),

    features: [
      m.project_music_f1(),
      m.project_music_f2(),
      m.project_music_f3(),
      m.project_music_f4(),
    ],
    techStack: [
      "TypeScript",
      "React",
      "Rust",
      "HTML",
      "TailwindCSS",
    ] as TechID[],
    caseStudyHref: "/projects/music-app",
    githubHref: "https://github.com/your-repo-music-app",
  },
  {
    label: "IMAGE_MANAGER_APP",
    title: m.project_image_title(),
    description: m.project_image_desc(),
    features: [
      m.project_image_f1(),
      m.project_image_f2(),
      m.project_image_f3(),
      m.project_image_f4(),
    ],
    techStack: ["TypeScript", "React", "Rust"] as TechID[],
    caseStudyHref: "/projects/image-manager",
    githubHref: "https://github.com/your-repo-image-manager",
  },
  {
    label: "PRODUCTIVITY_APP",
    title: m.project_productivity_title(),
    description: m.project_productivity_desc(),
    features: [
      m.project_productivity_f1(),
      m.project_productivity_f2(),
      m.project_productivity_f3(),
      m.project_productivity_f4(),
    ],
    techStack: ["TypeScript", "React", "Rust"] as TechID[],
    caseStudyHref: "/projects/productivity-app",
    githubHref: "https://github.com/your-repo-productivity-app",
  },
];
---

<Layout title="Zakiel" lang={Astro.currentLocale || "en"}>
  <Intro />

  <section id="projects-section" class="mt-[700px] flex flex-col gap-14">
    {
      projects.map((p, i) => (
        <ProjectCard
          index={i + 1}
          label={p.label}
          title={p.title}
          description={p.description}
          features={p.features}
          techStack={p.techStack}
          caseStudyHref={p.caseStudyHref}
          githubHref={p.githubHref}
        />
      ))
    }
  </section>

  <Profile />

  <script>
    import { scroll, animate } from "motion";

    const projects = document.querySelectorAll<HTMLElement>(".project-item");

    if (projects.length === 0) {
      console.warn(
        "No se encontraron todos los elementos necesarios para la animación de scroll."
      );
    }

    projects.forEach((project) => {
      const scrollOptions = {
        target: project,
        container: document.documentElement,

        offset: ["start 80%", "end 20%"] as const,
      };

      // --- ANIMACIÓN DE OPACIDAD ---
      scroll((progress: number) => {
        const opacity = progress < 0.5 ? progress * 2 : (1 - progress) * 2;
        animate(project, { opacity: opacity }, { duration: 0 });
      }, scrollOptions as any);

      // --- ANIMACIÓN DE TRANSFORMACIÓN ---
      scroll((progress: number) => {
        const translateY = (1 - progress) * 50;
        animate(
          project,
          { transform: `translateY(${translateY}px)` },
          { duration: 0 }
        );
      }, scrollOptions as any);
    });

    import { textScramble } from "../lib/textScramble.ts";

    const greetingElement = document.getElementById("greeting-text");
    const introElement = document.getElementById("intro-text");

    if (introElement) {
      // Opcional: definir un conjunto de caracteres japoneses personalizado
      const japaneseChars =
        "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
      /* const japaneseChars =
        "アァカサタナハマヤ"; */

      textScramble(introElement, {
        duration: 1.2, // Una duración más larga para un efecto más dramático
        speed: 0.05,
        characterSet: japaneseChars,
        delay: 2.5,
      });
    }

    if (greetingElement) {
      // Opcional: definir un conjunto de caracteres japoneses personalizado
      const japaneseChars =
        "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン";
      /* const japaneseChars =
        "アァカサタナハマヤ"; */

      textScramble(greetingElement, {
        duration: 1.2, // Una duración más larga para un efecto más dramático
        speed: 0.05,
        characterSet: japaneseChars,
        delay: 1,
      });
    }
  </script>
</Layout>
