<Layout>
	<header class="fixed top-8 left-12 right-12">
		<a href="" class="flex gap-2 text-[1.2rem] justify-start font-bold font-vcr uppercase items-center">
			<span class="text-[1.1rem]">[</span>
			<span class="tracking-wider">Zakiel</span>
			<span class="text-[1.1rem]" >]</span>
		</a>
		<div class="absolute top-0 right-0 ">
			<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-palette"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2c5.498 0 10 4.002 10 9c0 1.351 -.6 2.64 -1.654 3.576c-1.03 .914 -2.412 1.424 -3.846 1.424h-2.516a1 1 0 0 0 -.5 1.875a1 1 0 0 1 .194 .14a2.3 2.3 0 0 1 -1.597 3.99l-.156 -.009l.068 .004l-.273 -.004c-5.3 -.146 -9.57 -4.416 -9.716 -9.716l-.004 -.28c0 -5.523 4.477 -10 10 -10m-3.5 6.5a2 2 0 0 0 -1.995 1.85l-.005 .15a2 2 0 1 0 2 -2m8 0a2 2 0 0 0 -1.995 1.85l-.005 .15a2 2 0 1 0 2 -2m-4 -3a2 2 0 0 0 -1.995 1.85l-.005 .15a2 2 0 1 0 2 -2" /></svg>
		</div>
		<nav class="fixed top-24 bottom-12 flex flex-col items-center justify-between">
			<div class="flex flex-col gap-4">
				<span class="rotate-90 text-center text-2xl relative">&lt;</span>
				<div class="flex flex-col gap-6">
					<div class="h-1.5 w-2 bg-amber-50"></div>
					<div class="h-1.5 w-2 bg-amber-50"></div>
					<div class="h-1.5 w-2 bg-amber-50"></div>
					<div class="h-1.5 w-2 bg-amber-50"></div>
				</div>
				<span class="rotate-90 text-center text-2xl relative">></span>
			</div>
			{/* --- SOCIAL MEDIA ICONS --- */}
			<div class="">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
			</div>
		</nav>
	</header>
	<main class="flex pl-12">
		<section class="w-full h-screen flex flex-col justify-center items-center">
			<div class="w-[780px] flex flex-col gap-2  ml-15">
			  <h1 class="text-2xl uppercase font-bold leading-1 mb-2 tracking-[.3em]">Juan Mercedes</h1>
			  <div class="flex items-center gap-4 w-full ">
					<span class="text-8xl">Developer</span>
					<div class="w-full h-[3px] bg-[color-mix(in_lab,oklch(100%_0_0)_80%,transparent)] opacity-30 mt-4"></div>
		      </div>
			  <div class="flex gap-2 items-center">
				<span class="text-8xl">+</span>
				<span class="text-8xl">GameDev</span>
		      </div>
			</div>
	</main>
	
