---
import Layout from "../layouts/Layout.astro";
import "@fontsource/share-tech-mono";
import "@fontsource/vt323";

import { projects, techStack } from "../const";
import { m } from "../paraglide/messages";

import Loader2Icon from "@lucide/svelte/icons/loader-2";
import { Button } from "$lib/components/ui/button/index.js";
import ProjectCard from "src/components/ProjectCard.astro";
---

<Layout title="Zakiel" lang={Astro.currentLocale || "en"}>
  <main class="w-full flex-1">
    <!-- Juan Mercedes, Software Developer , Frontend , Backend -->
    <section class="">
      <h1 class="text-xl tracking-wider">
        {m.greetings()}
        <!-- — Web & Software Developer. -->
      </h1>

      <p class="text-lg mt-2">
        {m.intro()}
      </p>

      <div class="mt-12 flex flex-col gap-8">
        <section>
          <h2
            class="before:content-[''] before:rounded-[4px] before:inline-block before:size-4 dark:before:bg-white/80 before:bg-black before:mr-2 shrink-0 text-xl font-offbit"
          >
            {m.title_projects()}
          </h2>

          <div class="flex flex-col gap-14 mt-4">
            <!--  {
              projects.map((project) => (
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  features={project.features}
                  techStack={project.techStack}
                  caseStudyHref={project.caseStudyHref}
                  githubHref={project.githubHref}
                />
              ))
            } -->
            <ProjectCard
              title={m.project_music_title()}
              description={m.project_music_desc()}
              features={[
                m.project_music_f1(),
                m.project_music_f2(),
                m.project_music_f3(),
                m.project_music_f4(),
              ]}
              techStack={["TypeScript", "React", "Rust"]}
              caseStudyHref="/projects/music-app"
              githubHref="https://github.com/your-repo-music-app"
            />
            <ProjectCard
              title={m.project_image_title()}
              description={m.project_image_desc()}
              features={[
                m.project_image_f1(),
                m.project_image_f2(),
                m.project_image_f3(),
                m.project_image_f4(),
              ]}
              techStack={["TypeScript", "React", "Rust"]}
              caseStudyHref="/projects/image-manager"
              githubHref="https://github.com/your-repo-music-app"
            />
            <ProjectCard
              title={m.project_productivity_title()}
              description={m.project_productivity_desc()}
              features={[
                m.project_productivity_f1(),
                m.project_productivity_f2(),
                m.project_productivity_f3(),
                m.project_productivity_f4(),
              ]}
              techStack={["TypeScript", "React", "Rust"]}
              caseStudyHref="/projects/productivity-app"
              githubHref="https://github.com/your-repo-music-app"
            />
          </div>
        </section>

        <section class="mb-12">
          <span class="font-offbit">{m.about_title()}</span>
          <div class="flex flex-col gap-3">
            <span class="font-semibold">{m.about_subtitle()}</span>
            <p>
              {m.about_p1()}
            </p>

            <p>
              {m.about_p2()}
            </p>

            <p>
              {m.about_p3()}
            </p>

            <p>
              {m.about_p4()}
            </p>

            <span>My Techstack</span>
            <p>
              {m.tech()}
            </p>
            <div class="flex gap-5 flex-wrap">
              {
                techStack.map((tech) => (
                  <div>
                    {tech}
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>
</Layout>
